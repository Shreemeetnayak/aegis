# Server
PORT=5000
NODE_ENV=development

# GitHub — optional but recommended for higher API rate limits
# Generate at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# AI Provider — set to "gemini" or "openai" to enable AI-assisted reports
# Leave empty for deterministic-only reports (still fully functional)
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override AI model
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=20000

# Database — SQLite file path (created automatically)
# DATABASE_PATH=./data/aegis.db

# Cache TTL in minutes (default: 30)
# CACHE_TTL_MINUTES=30

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=60

# Frontend URL for CORS in production (comma-separated)
# FRONTEND_URL=https://aegis.example.com
